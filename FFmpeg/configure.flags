--prefix=/opt/quicksrt-ffmpeg-8.1.2
--extra-version=quicksrt
--arch=arm64
--target-os=darwin
--cc=/usr/bin/clang
--disable-autodetect
--disable-doc
--disable-debug
--disable-shared
--enable-static
--disable-gpl
--disable-version3
--disable-nonfree
--disable-ffplay
--disable-network
--disable-devices
--disable-encoders
--enable-encoder=pcm_s16le
--disable-muxers
--enable-muxer=wav
--enable-muxer=pcm_s16le
--disable-filters
--enable-filter=aresample
--extra-cflags=-mmacosx-version-min=15.0
--extra-ldflags=-mmacosx-version-min=15.0
